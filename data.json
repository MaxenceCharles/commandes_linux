[
  {
    "id": "cat_1",
    "name": "📂 Navigation & Fichiers",
    "commands": [
      {
        "id": "cmd_1",
        "name": "ls",
        "desc": "Lister le contenu d'un répertoire",
        "options": "-l (détails), -a (fichiers cachés), -h (taille lisible)",
        "example": "ls -la"
      },
      {
        "id": "cmd_2",
        "name": "cd",
        "desc": "Changer de répertoire",
        "options": ".. (dossier parent), ~ (dossier pers.), - (dossier précédent)",
        "example": "cd /var/log"
      },
      {
        "id": "cmd_3",
        "name": "pwd",
        "desc": "Afficher le répertoire courant",
        "options": "-P (chemin physique réel)",
        "example": "pwd"
      },
      {
        "id": "cmd_4",
        "name": "mkdir",
        "desc": "Créer un dossier",
        "options": "-p (crée toute l'arborescence parente)",
        "example": "mkdir -p projet/src/components"
      },
      {
        "id": "cmd_5",
        "name": "cp",
        "desc": "Copier des fichiers/dossiers",
        "options": "-r (récursif), -i (demander confirmation)",
        "example": "cp -r dossier_src/ dossier_dst/"
      },
      {
        "id": "cmd_6",
        "name": "mv",
        "desc": "Déplacer ou renommer un fichier",
        "options": "-i (confirmation avant écrasement)",
        "example": "mv fichier.txt /tmp/"
      },
      {
        "id": "cmd_7",
        "name": "rm",
        "desc": "Supprimer des fichiers/dossiers",
        "options": "-r (dossiers récursif), -f (forcer)",
        "example": "rm -rf dossier_inutile/"
      },
      {
        "id": "cmd_8",
        "name": "find",
        "desc": "Rechercher des fichiers dans l'arborescence",
        "options": "-name 'motif', -type f/d, -mtime -N",
        "example": "find . -name '*.log' -type f"
      },
      {
        "id": "cmd_1790249647239",
        "name": "df",
        "desc": "Afficher les tailles des dossiers en Mo ou Go",
        "options": "-h (human readable)",
        "example": "df -f"
      },
      {
        "id": "cmd_1790249930899",
        "name": "echo",
        "desc": "Afficher du texte, des variables ou le résultat d'une autre commande dans le terminal",
        "options": "-e (utiliser les caractères spéciaux)        -n (empêche le saut de ligne automatique à la fin du texte                                  \\n (pour aller a la ligne)                    \\t (pour ajouter une tabulation)",
        "example": "echo \"Ceci est un test\" > mon-fichier.txt"
      },
      {
        "id": "cmd_1790250227249",
        "name": "wc",
        "desc": "Compter le nombre de lignes, mots, caractères dans un fichier",
        "options": "-l (compte uniquement les lignes) -w (les mots) -c (le nombre d'octets) - m (le nombre de caractères)",
        "example": "wc -l fichier.txt"
      },
      {
        "id": "cmd_1790250390045",
        "name": "touch",
        "desc": "Créer un fichier s'il n'existe pas sinon, modifie les métadatas",
        "options": "-",
        "example": "touch fichier_1"
      },
      {
        "id": "cmd_1790250495415",
        "name": "ln",
        "desc": "Créer un lien symbolique",
        "options": "-s (symbolique)",
        "example": "ln -s fichier_1 lien_fichier_1"
      },
      {
        "id": "cmd_1790250746097",
        "name": "file",
        "desc": "Donner des informations sur un fichier",
        "options": "-",
        "example": "file fichier_1"
      },
      {
        "id": "cmd_1790250959348",
        "name": "history",
        "desc": "Equivaut à la flèche du haut pour l'historique des commandes avec date et heure de la commande",
        "options": "-",
        "example": "history"
      }
    ]
  },
  {
    "id": "cat_2",
    "name": "🔍 Lecture & Édition",
    "commands": [
      {
        "id": "cmd_9",
        "name": "cat",
        "desc": "Afficher le contenu d'un fichier",
        "options": "-n (numéroter les lignes)",
        "example": "cat config.conf"
      },
      {
        "id": "cmd_10",
        "name": "less",
        "desc": "Lire un fichier de façon interactive",
        "options": "Touches: q (quitter), / (chercher motif)",
        "example": "less /var/log/syslog"
      },
      {
        "id": "cmd_11",
        "name": "head / tail",
        "desc": "Afficher le début ou la fin d'un fichier",
        "options": "-n X (X lignes), -f (tail: suivi live)",
        "example": "tail -f -n 50 /var/log/syslog"
      },
      {
        "id": "cmd_12",
        "name": "grep",
        "desc": "Rechercher du texte dans des contenus",
        "options": "-i (sans casse), -r (récursif), -n (num. ligne)",
        "example": "grep -rn 'erreur' /var/log/"
      },
      {
        "id": "cmd_13",
        "name": "nano / vim",
        "desc": "Éditeurs de texte dans le terminal",
        "options": "Ctrl+O (sauver nano), :wq (sauver vim)",
        "example": "nano /etc/hosts"
      }
    ]
  },
  {
    "id": "cat_3",
    "name": "⚙️ Système & Processus",
    "commands": [
      {
        "id": "cmd_14",
        "name": "htop / top",
        "desc": "Superviser les ressources & processus en direct",
        "options": "Interactif (tri CPU, RAM, recherche)",
        "example": "htop"
      },
      {
        "id": "cmd_15",
        "name": "ps",
        "desc": "Lister les processus actifs",
        "options": "aux (tous les processus en détails)",
        "example": "ps aux | grep python"
      },
      {
        "id": "cmd_16",
        "name": "kill / killall",
        "desc": "Arrêter un ou plusieurs processus",
        "options": "-9 (forcer l'arrêt immédiat)",
        "example": "kill -9 1234"
      },
      {
        "id": "cmd_17",
        "name": "df",
        "desc": "Afficher l'espace disque disponible",
        "options": "-h (lisible Mo/Go), -T (type de FS)",
        "example": "df -h"
      },
      {
        "id": "cmd_18",
        "name": "du",
        "desc": "Estimer la taille d'un dossier",
        "options": "-s (total seul), -h (lisible Mo/Go)",
        "example": "du -sh /var/www/"
      },
      {
        "id": "cmd_19",
        "name": "free",
        "desc": "Afficher l'utilisation de la mémoire RAM",
        "options": "-h (lisible Mo/Go), -m (en Mo)",
        "example": "free -h"
      },
      {
        "id": "cmd_1790251400189",
        "name": "jobs",
        "desc": "Afficher les jobs en cours/terminés",
        "options": "-",
        "example": "jobs"
      },
      {
        "id": "cmd_1790251535780",
        "name": "fg",
        "desc": "Foreground - passe le jobs en 1er plan",
        "options": "%n (n = numéro du job à remonter) Ctrl-Z (stop le job au 1er plan)",
        "example": "fg %2"
      },
      {
        "id": "cmd_1790251630578",
        "name": "bg",
        "desc": "Background - Remet le job en arrière plan",
        "options": "%n (n = le job choisit)",
        "example": "bg %5"
      },
      {
        "id": "cmd_1790252285315",
        "name": "nice",
        "desc": "Met un niveau de gentillesse a la commande. La gentillesse impacte le niveau de priorité (de -20 à 19 par défaut 0)). Seul root est autorisé à baisser le niveau.",
        "options": "-n (niveau)",
        "example": "nice -n 10"
      },
      {
        "id": "cmd_1790252325584",
        "name": "ps",
        "desc": "Afficher les processus",
        "options": "-l (long)",
        "example": "ps -l"
      }
    ]
  },
  {
    "id": "cat_4",
    "name": "🔐 Permissions & Droits",
    "commands": [
      {
        "id": "cmd_20",
        "name": "chmod",
        "desc": "Modifier les permissions d'un fichier",
        "options": "+x (exécutable), -R (récursif), 755 / 644",
        "example": "chmod +x script.sh"
      },
      {
        "id": "cmd_21",
        "name": "chown",
        "desc": "Modifier le propriétaire / groupe",
        "options": "-R (récursif)",
        "example": "chown -R www-data:www-data /var/www/"
      },
      {
        "id": "cmd_22",
        "name": "sudo",
        "desc": "Exécuter une commande avec droits root",
        "options": "-i (ouvrir session root)",
        "example": "sudo apt update"
      },
      {
        "id": "cmd_1790251287424",
        "name": "umask",
        "desc": "Définir ou afficher le masque de permissions appliqué par défaut aux nouveaux fichiers et répertoires créés par un utilisateur ou un processus",
        "options": "-S (symbolique)",
        "example": "umask =rwx,g=rx,o="
      }
    ]
  },
  {
    "id": "cat_5",
    "name": "🌐 Réseau & Transfert",
    "commands": [
      {
        "id": "cmd_23",
        "name": "ping",
        "desc": "Tester l'accessibilité d'un hôte réseau",
        "options": "-c N (limiter à N envois)",
        "example": "ping -c 4 google.com"
      },
      {
        "id": "cmd_24",
        "name": "curl / wget",
        "desc": "Requêtes HTTP & Téléchargements",
        "options": "-O (curl: garder le nom), -I (en-têtes)",
        "example": "curl -O https://exemple.com/f.zip"
      },
      {
        "id": "cmd_25",
        "name": "ss / netstat",
        "desc": "Statistiques réseau et ports ouverts",
        "options": "-tulpn (ports TCP/UDP écoute + PID)",
        "example": "ss -tulpn"
      },
      {
        "id": "cmd_26",
        "name": "ssh",
        "desc": "Connexion sécurisée à un serveur distant",
        "options": "-p PORT (port spécifique), -i (clé SSH)",
        "example": "ssh user@192.168.1.50"
      }
    ]
  },
  {
    "id": "cat_1790195972248",
    "name": "🧰 Aides",
    "commands": [
      {
        "id": "cmd_1790196001032",
        "name": "man",
        "desc": "Afficher les détails pour une commande externe au shell",
        "options": "-",
        "example": "man grep"
      },
      {
        "id": "cmd_1790249582488",
        "name": "help",
        "desc": "Afficher les aides pour une commande interne au shell",
        "options": "-",
        "example": "help cd"
      },
      {
        "id": "cmd_1790249604108",
        "name": "type",
        "desc": "Connaitre l'origine de la commande (interne ou externe)",
        "options": "-",
        "example": "type grep"
      },
      {
        "id": "cmd_1790249623503",
        "name": "apropos",
        "desc": "Afficher un motif dans le manuel de la commande man",
        "options": "-",
        "example": "apropos \"disk\""
      },
      {
        "id": "cmd_1790249685000",
        "name": "uname",
        "desc": "Afficher les informations système",
        "options": "-",
        "example": "uname"
      },
      {
        "id": "cmd_1790249737179",
        "name": "who",
        "desc": "Montre qui est connecté",
        "options": "-",
        "example": "who"
      },
      {
        "id": "cmd_1790249761342",
        "name": "whoami",
        "desc": "Afficher le nom de l'utilisateur",
        "options": "-",
        "example": "whoami"
      },
      {
        "id": "cmd_1790250328949",
        "name": "alias",
        "desc": "Définit ou affiche des alias (si pas d'arguments)",
        "options": "-",
        "example": "alias ll=\"ls-l\""
      }
    ]
  }
]